# ---- LLM provider (pick ONE; all optional — app runs without any) ----
# OpenAI (default). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Google Gemini alternative:
#   GEMINI_API_KEY=your_key
#   LLM_MODEL=gemini/gemini-1.5-flash
#
# Fully local / free via Ollama (no key needed), after `ollama pull llama3.1`:
#   LLM_MODEL=ollama/llama3.1

# ---- Job board (optional; falls back to bundled sample jobs) ----
# Free API keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ---- Embeddings (local, free, no key) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Phase 3: LangSmith Observability & Tracing (optional) ----
# Free sign-up at https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-hunt-agent

# ---- Phase 3: Web Search Provider (optional; DuckDuckGo works with zero keys) ----
# TAVILY_API_KEY=
